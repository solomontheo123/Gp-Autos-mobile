{
  "expo": {
    "name": "GP Autos Mobile",
    "slug": "gp-autos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/gp-autos-splash.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gpautos.mobile"
    },
    "android": {
      "package": "com.gpautos.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/gp-autos-splash.png",
        "backgroundImage": "./assets/gp-autos-splash.png",
        "monochromeImage": "./assets/gp-autos-splash.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/gp-autos-splash.png",
          "imageWidth": 180
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5702b097-ca82-46b3-8648-cf9642b79919"
      }
    },
    "owner": "solomon-theophilus"
  }
}
